# rex-xstream configuration.
# Copy this file to .env and replace every placeholder.
# Never commit the real .env file.

APP_HOST=0.0.0.0
APP_PORT=9981
# The address rex uses to fetch streams, as seen from the rex machine.
PUBLIC_URL=http://192.168.1.20:9981
APP_VERSION=dev

DATABASE_PATH=/data/rex-xstream.db
LOG_LEVEL=info

# Bearer token for the administrative API. At least 16 characters.
API_TOKEN=replace-with-a-long-random-token
# Base64 of exactly 32 random bytes. Used to encrypt provider credentials.
ENCRYPTION_KEY=replace-with-base64-of-32-random-bytes

# Credentials rex presents when it fetches streams and logos.
REX_SOURCE_USER=rex
REX_SOURCE_PASSWORD=replace-with-a-long-random-password
# Optional Plex token for renaming library titles when a playlist is renamed.
REX_TOKEN=

# rex integration. Leave REX_ENABLED=false to run standalone.
REX_ENABLED=true
REX_URL=http://192.168.1.20:32400
REX_SOURCE_NAME=rex-xstream
REX_PUSH_BATCH=100
# Send TMDB ids so Plex names and describes items. Set false when the same title
# also exists in another REX source and must stay in its own library.
REX_SEND_TMDB_IDS=true

# Synchronisation.
SYNC_ON_START=true
SYNC_ON_CREATE=true
SYNC_INTERVAL=6h
SYNC_CONCURRENCY=4
PROBE_WORKERS=4
PROBE_TIMEOUT=30s
HTTP_TIMEOUT=45s
EPG_DAYS=7

# Optional limits. 0 means every item the provider returns.
# Use these to verify a provider without probing an entire catalogue.
SYNC_MAX_MOVIES=0
SYNC_MAX_SERIES=0
SYNC_MAX_LIVE=0

# Probes run ffprobe. The Docker image includes it.
FFPROBE_PATH=ffprobe

# SSRF protection. Keep false unless the provider is on your own network.
XC_ALLOW_PRIVATE_HOSTS=false

RATE_LIMIT_PER_MINUTE=120
CORS_ORIGINS=
